# Shared secrets and config for the Rust service fleet (identity, players,
# servers, guilds, coordinator) defined in infra/docker-compose.yml.
#
# POSTGRES_URL and REDIS_URL are intentionally NOT here: compose sets them
# explicitly per service to point at the compose network's postgres/redis
# containers, and PORT is likewise hardcoded per service in compose.
#
# Local dev: copy this file to infra/rustlens.env and fill in the blanks, or
# reuse whatever the Go backend already has configured:
#   cp apps/backend/.env infra/rustlens.env
# The Go backend keeps reading its own apps/backend/.env until that file is
# deleted, so the two env files can safely coexist and diverge. Go-only vars
# (APP_ADMIN_DISCORD_IDS, TRUST_PROXY_HEADERS, TRUST_PROXY_IP_HEADER,
# TRUST_PROXY_GEO_HEADER) stay in apps/backend/.env; no Rust service reads
# them today.

APP_API_INTERNAL_SECRET=dev-app-internal-secret
APP_SESSION_SECRET=dev-app-session-secret
BOT_SERVICE_JWT_SECRET=
BOT_JWT_ISSUER=rustlens-bot
BOT_JWT_AUDIENCE=rustlens-backend

# Discord OAuth: register an app at https://discord.com/developers/applications
# OAuth2 -> Redirects must include ${APP_ORIGIN}/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# Ed25519 public key (hex) verifying the coordinator's Discord webhook route;
# empty disables that route.
DISCORD_APP_PUBLIC_KEY=

APP_ORIGIN=http://localhost
APP_BASE_URL=http://localhost:3000

STEAM_API_KEY=

# Steam <-> BattleMetrics resolution (players service).
# Primary source: bmsearch.io public (no-auth) API. Cache reads are instant;
# cold players are enqueued and resolved asynchronously, so a Steam-first
# lookup that misses returns Steam-only now and the bm_id is backfilled in the
# background. BM_SEARCH_INLINE_TIMEOUT_MS bounds the inline wait before backfill.
BM_SEARCH_ENABLED=true
BM_SEARCH_URL=https://bmsearch.io/api
BM_SEARCH_INLINE_TIMEOUT_MS=4000
# Optional legacy fallback: the retired external bmmatch service. Tried only
# after bmsearch. Direct (never proxied). Empty values disable it.
BM_MATCH_URL=
BM_MATCH_TOKEN=

PLATFORMSYNC_TOKEN=

# BattleMetrics polling + outbound proxy pool (players + servers services).
BATTLEMETRICS_SERVER_POLL_INTERVAL_SECONDS=30
PROXY_ENABLED=false
PROXY_ENDPOINTS=
PROXY_ENCRYPTION_KEY=

# Bot shard coordination (coordinator service).
BOT_TARGET_SHARDS=4
BOT_HEARTBEAT_TTL_SECONDS=45

# Wipe-react schedule poller tick interval, seconds (guilds service).
WIPE_SCHEDULER_INTERVAL_SECONDS=60

# Retention sweep cadence + windows, seconds (coordinator service).
CLEANUP_INTERVAL_SECONDS=3600
CLEANUP_WIPE_REACT_RETENTION_SECONDS=604800
CLEANUP_ANALYTICS_CACHE_RETENTION_SECONDS=172800
CLEANUP_COMMAND_USAGE_RETENTION_SECONDS=7776000
