PORT=8080
POSTGRES_URL=postgres://rustlens:rustlens@localhost:5432/rustlens?sslmode=disable
REDIS_URL=redis://localhost:6379/0
APP_API_INTERNAL_SECRET=
APP_SESSION_SECRET=
BOT_SERVICE_JWT_SECRET=
BOT_JWT_ISSUER=rustlens-bot
BOT_JWT_AUDIENCE=rustlens-backend
BOT_TARGET_SHARDS=4
BOT_HEARTBEAT_TTL_SECONDS=45
STEAM_API_KEY=
# External Steam ↔ BattleMetrics matching service (https://github.com/...).
# Direct (never proxied). Empty values disable backfill via this service.
BM_MATCH_URL=
BM_MATCH_TOKEN=
PLATFORMSYNC_TOKEN=
BATTLEMETRICS_SERVER_POLL_INTERVAL_SECONDS=30
PROXY_ENABLED=false
PROXY_ENDPOINTS=
PROXY_ENCRYPTION_KEY=
APP_API_INTERNAL_SECRET=dev-app-internal-secret
APP_SESSION_SECRET=dev-app-session-secret
# Discord OAuth — register an app at https://discord.com/developers/applications
# OAuth2 → Redirects must include ${APP_ORIGIN}/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
APP_ORIGIN=http://localhost
