PORT=8080
POSTGRES_URL=postgres://rustlens:rustlens@localhost:5432/rustlens?sslmode=disable
REDIS_URL=redis://localhost:6379/0
APP_API_INTERNAL_SECRET=
APP_SESSION_SECRET=
BOT_SERVICE_JWT_SECRET=
BOT_JWT_ISSUER=rustlens-bot
BOT_JWT_AUDIENCE=rustlens-backend
BOT_TARGET_SHARDS=4
BOT_HEARTBEAT_TTL_SECONDS=45
STEAM_API_KEY=
# Steam ↔ BattleMetrics resolution.
# Primary source: bmsearch.io public (no-auth) API. Cache reads are instant;
# cold players are enqueued and resolved asynchronously, so a Steam-first
# lookup that misses returns Steam-only now and the bm_id is backfilled in the
# background. BM_SEARCH_INLINE_TIMEOUT_MS bounds the inline wait before backfill.
BM_SEARCH_ENABLED=true
BM_SEARCH_URL=https://bmsearch.io/api
BM_SEARCH_INLINE_TIMEOUT_MS=4000
# Optional legacy fallback: the retired external bmmatch service. Tried only
# after bmsearch. Direct (never proxied). Empty values disable it.
BM_MATCH_URL=
BM_MATCH_TOKEN=
PLATFORMSYNC_TOKEN=
BATTLEMETRICS_SERVER_POLL_INTERVAL_SECONDS=30
PROXY_ENABLED=false
PROXY_ENDPOINTS=
PROXY_ENCRYPTION_KEY=
APP_API_INTERNAL_SECRET=dev-app-internal-secret
APP_SESSION_SECRET=dev-app-session-secret
# Discord OAuth — register an app at https://discord.com/developers/applications
# OAuth2 → Redirects must include ${APP_ORIGIN}/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
APP_ORIGIN=http://localhost

# Trusted edge headers (Cloudflare + reverse proxy). Only enable when the
# edge strips client-supplied copies of these headers before re-injecting
# them; otherwise clients can spoof their IP / country.
TRUST_PROXY_HEADERS=false
TRUST_PROXY_IP_HEADER=CF-Connecting-IP
TRUST_PROXY_GEO_HEADER=CF-IPCountry

# Go-removal dual-run kill switches. These two background workers run
# lock-free in Go, so once the corresponding Rust replacement takes over
# during the cutover window, flip the matching flag to true to avoid
# double-processing. Default false (workers run).
DISABLE_WIPE_REACT_SCHEDULER=false
DISABLE_CLEANUP_WORKER=false
